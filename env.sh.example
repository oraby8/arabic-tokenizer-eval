# Copy to env.sh and adjust. Every script reads $B as the project root;
# data/, results/, tokenizers/ and logs/ live under it.
export B=/path/to/arabic-tokenizer-eval
# Keep caches off a small root disk if needed:
export HF_HOME=$B/hf             # put your Hugging Face token in $HF_HOME/token (or run `hf auth login`)
export UV_CACHE_DIR=$B/uvcache
export TMPDIR=$B/tmp
export HF_XET_HIGH_PERFORMANCE=1
